end

local landingOffsets = {
    Vector3.new(4, 0, 0), Vector3.new(-4, 0, 0), Vector3.new(0, 0, 4), Vector3.new(0, 0, -4),
    Vector3.new(3, 0, 3), Vector3.new(-3, 0, 3), Vector3.new(3, 0, -3), Vector3.new(-3, 0, -3),
    Vector3.new(7, 0, 0), Vector3.new(-7, 0, 0), Vector3.new(0, 0, 7), Vector3.new(0, 0, -7),
    Vector3.new(5, 0, 5), Vector3.new(-5, 0, 5), Vector3.new(5, 0, -5), Vector3.new(-5, 0, -5),
}
local function findLandingSpot(destination)
    local base = Vector3.new(destination.X, destination.Y + CFG.StandOffset, destination.Z)
    if pointClear(base) then return base end
    local limit = CFG.InteractDistance - 1
    for _, offset in ipairs(landingOffsets) do
        if horizontal(offset).Magnitude <= limit then
            local candidate = base + offset
            if pointClear(candidate) then return candidate end
        end
    end
    return base
end

local function verticalTo(targetY, speed)
    if typeof(targetY) ~= "number" or targetY ~= targetY then return false end
    if cancelled() or not validCharacter() then return false end
    local movingRoot = root
    local startY = movingRoot.Position.Y
    if math.abs(startY - targetY) <= 1.5 then return true end
    if not beginFlightControl() then return false end
    noclip = true
    setCollisions(false)
    ensureLift(movingRoot)
    local deadline = os.clock() + math.min(8, math.abs(targetY - startY) / math.max(speed, 1) + 3)
    local reached = false
    while not cancelled() and validCharacter() and root == movingRoot
        and os.clock() < deadline do
        local remaining = targetY - movingRoot.Position.Y
        if math.abs(remaining) <= 1.2 then reached = true; break end
        local vy = math.clamp(remaining * 4, -speed, speed)
        movingRoot.AssemblyLinearVelocity = Vector3.new(0, vy, 0)
        task.wait(CFG.FlyPoll)
    end
    if movingRoot.Parent then movingRoot.AssemblyLinearVelocity = Vector3.zero end
    removeLift()
    return reached and not cancelled() and validCharacter() and root == movingRoot
end

local function velocityLeg(target, speed, onProgress, glideY, tolerance)
    if cancelled() or not validCharacter() then return false end
    local movingRoot, start = root, root.Position
    local delta = target - start
    local length = horizontal(delta).Magnitude
    local tolerance = tolerance or CFG.ArriveXZ
    if length <= tolerance then return true end
    if not beginFlightControl() then return false end
    noclip = true
    setCollisions(false)
    ensureLift(movingRoot)
    local projectedDirection = horizontal(delta).Unit
    local nextReport = 0
    local lastRemaining, progressAt = length, os.clock()
    local function applyWanted(remaining)
        local wanted = projectedDirection * speed
        if glideY then
            local diff = glideY - movingRoot.Position.Y
            if math.abs(diff) > 0.5 then
                local timeLeft = math.max(remaining / math.max(speed, 1), 0.05)
                local vy = math.clamp(diff / timeLeft, -CFG.DescendSpeed, CFG.ClimbSpeed)
                wanted = wanted + Vector3.new(0, vy, 0)
            end
        end
        local current = movingRoot.AssemblyLinearVelocity
        if (current - wanted).Magnitude > speed * 0.12 then
            movingRoot.AssemblyLinearVelocity = wanted
        end
    end
    applyWanted(length)
    local deadline = os.clock() + math.min(CFG.FlightTimeout, delta.Magnitude / speed * 3 + 4)
    local arrived = false
    local stalled = false
    while not cancelled() and validCharacter() and root == movingRoot
        and os.clock() < deadline do
        local now = os.clock()
        local position = movingRoot.Position
        local remaining = xzDistance(position, target)
        if remaining <= tolerance then arrived = true; break end
        if remaining < lastRemaining - 1 then
            lastRemaining, progressAt = remaining, now
        elseif now - progressAt > CFG.StallTimeout then
            stalled = true
            break
        end
        local displacement = horizontal(position - start)
        if displacement:Dot(projectedDirection) >= length then
            arrived = true
            break
        end
        applyWanted(remaining)
        if onProgress and now >= nextReport then
            nextReport = now + 0.25
            onProgress(remaining, speed)
        end
        task.wait(CFG.FlyPoll)
    end
    if movingRoot.Parent then movingRoot.AssemblyLinearVelocity = Vector3.zero end
    removeLift()
    return arrived and not cancelled() and validCharacter() and root == movingRoot, stalled
end

local function touchDown(surfaceY)
    if cancelled() or not validCharacter() then return false end
    local movingRoot = root
    if typeof(surfaceY) ~= "number" or surfaceY ~= surfaceY then surfaceY = nil end
    removeLift()
    endFlightControl(true)
    noclip = false
    setCollisions(true)
    movingRoot.AssemblyLinearVelocity = Vector3.new(0, -14, 0)
    movingRoot.AssemblyAngularVelocity = Vector3.zero
    local deadline = os.clock() + math.min(5, CFG.LandingTimeout)
    local landed = false
    while not cancelled() and validCharacter() and root == movingRoot
        and os.clock() < deadline do
        local onFloor = false
        if humanoid then
            local ok, floor = pcall(function() return humanoid.FloorMaterial end)
            onFloor = ok and floor ~= nil and floor ~= Enum.Material.Air
        end
        local fallSpeed = math.abs(movingRoot.AssemblyLinearVelocity.Y)
        local lowEnough = surfaceY ~= nil
            and movingRoot.Position.Y <= surfaceY + CFG.StandOffset + 0.4
            and fallSpeed < 4
        if onFloor or lowEnough then
            landed = true
            break
        end
        task.wait(CFG.LandPoll)
    end
    return landed and not cancelled() and validCharacter() and root == movingRoot
end

local function flyTo(destination, label, showRoute)
    if typeof(destination) ~= "Vector3" or cancelled() or not validCharacter() then
        return false
    end
    local movingRoot = root
    local start = movingRoot.Position
    local distance = xzDistance(start, destination)
    if distance <= CFG.ArriveXZ and math.abs(start.Y - (destination.Y + CFG.StandOffset)) <= 8 then
        return true
    end
    local cruiseY = destination.Y + CFG.CruiseHeight
    local groundY = destination.Y + CFG.StandOffset
    local speed = cruiseSpeed(distance)
    local function report(_, currentSpeed)
        if cancelled() or not validCharacter() or root ~= movingRoot then return end
        local position = movingRoot.Position
        local left = xzDistance(position, destination)
        if showRoute then
            routeProgress = 1 - math.clamp(left / math.max(distance, 1), 0, 1)
            setBar(routeProgress)
        end
        if not label then return end
        status(label .. tostring(math.floor(left)), nil)
        detail(string.format("cao %d | còn %d | %d studs/s",
            math.floor(position.Y), math.floor(left), math.floor(currentSpeed + 0.5)))
    end
    local arrived = xzDistance(root.Position, destination) <= CFG.ArriveXZ
    local stalled = false
    if not arrived then
        local toCenter = horizontal(destination - start)
        local direction = toCenter.Magnitude > 0.01 and toCenter.Unit or Vector3.zero
        if distance > CFG.ApproachDistance + CFG.ArriveXZ then
            if math.abs(start.Y - cruiseY) > 2 then
                movingRoot.AssemblyLinearVelocity = Vector3.zero
                movingRoot.CFrame = CFrame.new(start.X, cruiseY, start.Z)
            end
            if cancelled() or not validCharacter() or root ~= movingRoot then return false end
            local entry = Vector3.new(
                destination.X - direction.X * CFG.ApproachDistance,
                cruiseY,
                destination.Z - direction.Z * CFG.ApproachDistance)
            arrived, stalled = velocityLeg(entry, speed, report)
        end
        if not stalled and not cancelled() and validCharacter() and root == movingRoot then
            local position = movingRoot.Position
            local surface = surfaceAheadY(position.X, position.Z, position.Y + 30)
            local descended = verticalTo((surface or destination.Y) + CFG.StandOffset + CFG.DropHeight, CFG.DescendSpeed)
            if descended and not cancelled() and validCharacter() and root == movingRoot then
                touchDown(surface or destination.Y)
            end
        end
        if not stalled and not cancelled() and validCharacter() and root == movingRoot then
            local center = Vector3.new(destination.X, groundY, destination.Z)
            arrived, stalled = velocityLeg(center, CFG.ApproachSpeed, report, groundY, CFG.ApproachTolerance)
        end
    end
    for attempt = 1, 3 do
        if stalled then break end
        if cancelled() or not validCharacter() or root ~= movingRoot then return false end
        if arrived and xzDistance(root.Position, destination) <= CFG.ArriveXZ then break end
        if xzDistance(root.Position, destination) <= CFG.ArriveXZ then arrived = true; break end
        local correction = Vector3.new(destination.X, groundY, destination.Z)
        arrived, stalled = velocityLeg(correction, CFG.ApproachSpeed, report, groundY, CFG.ApproachTolerance)
    end
    if not arrived or cancelled() or not validCharacter() or root ~= movingRoot then
        return false
    end
    if showRoute then
        routeProgress = 1
        setBar(1)
    end
    removeLift()
    movingRoot.AssemblyLinearVelocity = Vector3.zero
    movingRoot.AssemblyAngularVelocity = Vector3.zero
    local landing = findLandingSpot(destination)
    movingRoot.CFrame = CFrame.new(landing.X, landing.Y, landing.Z)
    endFlightControl(false)
    noclip = false
    setCollisions(true)
    local deadline = os.clock() + CFG.LandingTimeout
    local settled = false
    local retriedLanding = false
    while not cancelled() and validCharacter() and root == movingRoot
        and os.clock() < deadline do
        local position = movingRoot.Position
        local fallSpeed = math.abs(movingRoot.AssemblyLinearVelocity.Y)
        if xzDistance(position, landing) <= CFG.ArriveXZ
            and math.abs(position.Y - landing.Y) <= CFG.InteractVertical
            and fallSpeed < 12 then
            settled = true
            break
        end
        if not retriedLanding and os.clock() > deadline - CFG.LandingTimeout * 0.4 then
            retriedLanding = true
            local retrySpot = findLandingSpot(destination)
            if retrySpot ~= landing then
                landing = retrySpot
                movingRoot.AssemblyLinearVelocity = Vector3.zero
                movingRoot.AssemblyAngularVelocity = Vector3.zero
                movingRoot.CFrame = CFrame.new(landing.X, landing.Y, landing.Z)
            end
        end
        task.wait(CFG.LandPoll)
    end
    return settled and not cancelled() and validCharacter() and root == movingRoot
end

local function teleportCharacter(position)
    if cancelled() or not validCharacter() or typeof(position) ~= "Vector3" then
        return false
    end
    local movingRoot = root
    removeLift()
    endFlightControl(false)
    noclip = false
    setCollisions(true)
    movingRoot.AssemblyLinearVelocity = Vector3.zero
    movingRoot.AssemblyAngularVelocity = Vector3.zero
    movingRoot.CFrame = CFrame.new(position.X, position.Y, position.Z)
    if humanoid then
        pcall(function()
            humanoid.Sit = false
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
            humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        end)
    end
    return not cancelled() and validCharacter() and root == movingRoot
end

local function jumpOnce()
    if not validCharacter() then return end
    if vim and type(vim.SendKeyEvent) == "function" then
        pcall(function()
            vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
    end
    pcall(function()
        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
end

local function waitLanded(target)
    local landed = false
    local deadline = os.clock() + CFG.PickupSettleTimeout
    while not cancelled() and validCharacter() and os.clock() < deadline do
        local position = root.Position
        local fallSpeed = math.abs(root.AssemblyLinearVelocity.Y)
        local onFloor = false
        if humanoid then
            local ok, floor = pcall(function() return humanoid.FloorMaterial end)
            onFloor = ok and Enum.Material ~= nil and floor ~= nil and floor ~= Enum.Material.Air
        end
        if position.Y <= target.Y + CFG.InteractVertical and (onFloor or fallSpeed < 6) then
            landed = true
            break
        end
        task.wait(0.05)
    end
    return landed
end

local function dropTo(target, height)
    local spot = findLandingSpot(target)
    if not teleportCharacter(Vector3.new(spot.X, target.Y + height, spot.Z)) then
        return false
    end
    if not pause(CFG.DropJumpDelay) then return false end
    jumpOnce()
    return waitLanded(target)
end

local function teleportStuckReset(target, delivering)
    if cancelled() or not validCharacter() or typeof(target) ~= "Vector3" then
        return false
    end
    local attempts, height
    if delivering then
        destAttempts = destAttempts + 1
        destDropOffset = math.min(destDropOffset + CFG.PickupDropStep, CFG.PickupDropMax)
        attempts, height = destAttempts, destDropOffset
        status("Kẹt giao → teleport xa", COLOR.stuck)
    else
        pickAttempts = pickAttempts + 1
        pickDropOffset = math.min(pickDropOffset + CFG.PickupDropStep, CFG.PickupDropMax)
        attempts, height = pickAttempts, pickDropOffset
        status("Kẹt nhặt → teleport xa", COLOR.stuck)
    end
    local far = CFG.ResetFarMin + math.random() * (CFG.ResetFarMax - CFG.ResetFarMin)
    local angle = math.random() * math.pi * 2
    local farX = target.X + math.cos(angle) * far
    local farZ = target.Z + math.sin(angle) * far
    local groundY = surfaceAheadY(farX, farZ, math.max(target.Y, root.Position.Y) + 400)
    local away = Vector3.new(farX, (groundY or target.Y) + CFG.PickupResetHeight, farZ)
    for _ = 1, 5 do
        if pointClear(away) then break end
        far = CFG.ResetFarMin + math.random() * (CFG.ResetFarMax - CFG.ResetFarMin)
        angle = math.random() * math.pi * 2
        farX = target.X + math.cos(angle) * far
        farZ = target.Z + math.sin(angle) * far
        groundY = surfaceAheadY(farX, farZ, math.max(target.Y, root.Position.Y) + 400)
        away = Vector3.new(farX, (groundY or target.Y) + CFG.PickupResetHeight, farZ)
    end
    detail(string.format("lần %d | xa %d | thả cao %d", attempts, math.floor(far), height))
    if not teleportCharacter(away) then return false end
    if not pause(CFG.DropJumpDelay) then return false end
    jumpOnce()
    if not pause(CFG.PickupResetWait) then return false end
    local landed = dropTo(target, height)
    detail(string.format("lần %d | xa %d | thả cao %d | %s", attempts, math.floor(far), height,
        landed and "đã chạm đất" or "chờ hạ cánh"))
    return not cancelled() and validCharacter()
end

local function runWorker(kind, action)
    if worker or cancelled() then return end
    startingJob = kind == "start"
    traveling = kind ~= "start"
    worker = task.defer(function()
        local ok, result = pcall(action)
        releaseMouse()
        finishMotion()
        traveling, startingJob, worker = false, false, nil
        pickStuck, destStuck = nil, nil
        nextRemote = os.clock() + 0.20
        if not cancelled() and (not ok or result == false) then
            if not ok then warn("[AD] " .. tostring(result)) end
            status("Thao tác thất bại / timeout", COLOR.error)
            nextTick = os.clock() + 1
        end
    end)
end

local function getPadPosition(container, prompt)
    if not container or not container.Parent or not prompt or not prompt.Parent then return nil end
    local anchor = prompt.Parent
    if anchor:IsA("Attachment") then return anchor.WorldPosition end
    if anchor:IsA("BasePart") then return anchor.Position end
    if anchor:IsA("Model") then
        if anchor.PrimaryPart then return anchor.PrimaryPart.Position end
        for _, part in ipairs(anchor:GetDescendants()) do
            if part:IsA("BasePart") then return part.Position end
        end
    end
    if container:IsA("BasePart") then return container.Position end
    if container:IsA("Model") and container.PrimaryPart then
        return container.PrimaryPart.Position
    end
    for _, part in ipairs(container:GetDescendants()) do
        if part:IsA("BasePart") then return part.Position end
    end
    return nil
end

local function findPad()
    if padContainer and padContainer:IsDescendantOf(workspace) and padPrompt
        and padPrompt:IsDescendantOf(padContainer) then
        local position = getPadPosition(padContainer, padPrompt)
        if typeof(position) == "Vector3" then return position, padPrompt end
    end
    if os.clock() < nextPadScan then return nil end
    nextPadScan = os.clock() + 2
    local gameFolder = workspace:FindFirstChild("Game")
    local jobs = gameFolder and gameFolder:FindFirstChild("Jobs")
    local delivery = jobs and jobs:FindFirstChild("Delivery")
    local locations = delivery and delivery:FindFirstChild("DeliveryLocations")
    if not locations then return nil end
    local best, bestPrompt, bestPosition, bestDistance
    for _, candidate in ipairs(locations:GetDescendants()) do
        if candidate.Name == "DeliveryJobPad" then
            local prompt = candidate:FindFirstChild("JobPadPrompt", true)
            if prompt and prompt:IsA("ProximityPrompt") then
                local position = getPadPosition(candidate, prompt)
                if typeof(position) == "Vector3" then
                    local distance = root and xzDistance(root.Position, position) or 0
                    if not bestDistance or distance < bestDistance then
                        best, bestPrompt, bestPosition, bestDistance = candidate, prompt, position, distance
                    end
                end
            end
        end
    end
    padContainer, padPrompt = best, bestPrompt
    if best then return bestPosition, bestPrompt end
    return nil
end

local function startJob(padPosition, prompt)
    status("Bay đến bảng nhận việc", COLOR.start)
    detail(string.format("Pad %.0f, %.0f, %.0f", padPosition.X, padPosition.Y, padPosition.Z))
    if not flyTo(padPosition, "→ pad ") or cancelled() then return false end
    local stateOK, active = readState()
    if stateOK and active then return true end
    if type(fireproximityprompt) ~= "function" then
        session.Stop("Executor thiếu fireproximityprompt")
        return false
    end
    if not vim then
        session.Stop("Không có VirtualInputManager")
        return false
    end
    local camera = workspace.CurrentCamera
    if camera and (CFG.AcceptX >= camera.ViewportSize.X or CFG.AcceptY >= camera.ViewportSize.Y) then
        detail("Sửa CFG.AcceptX / AcceptY cho màn hình")
        session.Stop("Tọa độ click ngoài màn hình")
        return false
    end
    if not prompt.Parent or not prompt:IsDescendantOf(workspace) then return false end
    for attempt = 1, 3 do
        if cancelled() or not validCharacter() then return false end
        if attempt > 1 then
            status("Thử nhận job lại", COLOR.start)
            detail(string.format("lần %d/3", attempt))
            if not pause(0.8) then return false end
            local refreshedPosition, refreshedPrompt = findPad()
            if refreshedPrompt and refreshedPrompt.Parent then
                prompt = refreshedPrompt
                if typeof(refreshedPosition) == "Vector3" then padPosition = refreshedPosition end
            end
        end
        if not prompt or not prompt.Parent or not prompt:IsDescendantOf(workspace) then
            local refreshedPosition, refreshedPrompt = findPad()
            if not refreshedPrompt then return false end
            prompt = refreshedPrompt
            if typeof(refreshedPosition) == "Vector3" then padPosition = refreshedPosition end
        end
        local currentPadPosition = getPadPosition(padContainer, prompt)
        if typeof(currentPadPosition) == "Vector3" then padPosition = currentPadPosition end
        if xzDistance(root.Position, padPosition) > CFG.InteractDistance then
            status("Quay lại bảng nhận việc", COLOR.start)
            if not flyTo(padPosition, "→ pad ") or cancelled() then return false end
        end
        status("Đang nhận job", COLOR.start)
        local promptOK, promptError = pcall(fireproximityprompt, prompt, 0)
        if not promptOK then
            warn("[AD] Prompt: " .. tostring(promptError))
        else
            if not pause(CFG.PromptDelay) or not validCharacter() then return false end
            mousePressed = true
            pcall(function()
                if type(vim.SendMouseMoveEvent) == "function" then
                    vim:SendMouseMoveEvent(CFG.AcceptX, CFG.AcceptY, game)
                end
            end)
            local clickOK, clickError = pcall(function()
                vim:SendMouseButtonEvent(CFG.AcceptX, CFG.AcceptY, 0, true, game, 0)
            end)
            local held = clickOK and pause(CFG.ClickHold)
            local releaseOK, releaseError = releaseMouse()
            if not clickOK or not releaseOK then
                warn("[AD] Click: " .. tostring(clickError or releaseError))
            elseif not held or not validCharacter() then
                return false
            else
                local deadline = os.clock() + CFG.JobConfirmTimeout
                while not cancelled() and validCharacter() and os.clock() < deadline do
                    local ok, hasJob = readState()
                    if ok and hasJob then resetProgress(); return true end
                    task.wait(0.10)
                end
            end
        end
    end
    return false
end

local function sendRemote(remote)
    local now = os.clock()
    if cancelled() or pending[remote] or now < nextRemote or not remote.Parent then return end
    nextRemote = now + CFG.RemoteInterval
    local call = {deadline = now + CFG.RemoteTimeout}
    pending[remote] = call
    call.thread = task.defer(function()
        local ok, err = pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer()
            else
                remote:InvokeServer()
            end
        end)
        if pending[remote] == call then pending[remote] = nil end
        if not ok and not cancelled() then
            warn("[AD] Remote " .. remote.Name .. ": " .. tostring(err))
            status("Remote lỗi; sẽ thử lại", COLOR.error)
        end
    end)
end

local function refreshRemotes()
    local folder = RS:FindFirstChild("Remotes")
    if not folder then return end
    if not (pickupRemote and pickupRemote.Parent) then
        local candidate = folder:FindFirstChild("AttemptDeliveryPickup")
        if validRemote(candidate) then pickupRemote = candidate end
    end
    if not (completeRemote and completeRemote.Parent) then
        local candidate = folder:FindFirstChild("AttemptDeliveryComplete")
        if validRemote(candidate) then completeRemote = candidate end
    end
end

local function finishSplash()
    if ready then return end
    hideSplash()
    status("Auto Delivery đã sẵn sàng", COLOR.idle)
    detail("")
    setBar(0)
    setRunButton(true)
    nextTick, nextJob = 0, 0
end
local function updateStartup(now)
    if ready then return end
    local elapsed = now - startupStarted
    if not gameLoaded() then
        setSplash("Đang tải game...", 0.10 + math.min(0.08, elapsed * 0.03))
    elseif not validCharacter() then
        setSplash("Đang chờ nhân vật...", 0.34)
    else
        local ok, active = readState()
        if not ok then
            setSplash(stateRequest and "Đang đọc dữ liệu nhiệm vụ..." or "Chưa đọc được dữ liệu nhiệm vụ", 0.58)
        else
            local padPosition = findPad()
            if padPosition then
                setSplash(active and "Đã nhận nhiệm vụ, bắt đầu chạy..." or "Sẵn sàng nhận nhiệm vụ", 1)
            else
                setSplash(active and "Đang chuẩn bị điểm nhận..." or "Đang tìm bảng nhận việc...", 0.8)
            end
        end
    end
    local done = elapsed >= 0.35 and splashTarget >= 0.999
    local fallback = elapsed >= 15 or (elapsed >= 3.5 and splashTarget >= 0.75)
    if done or fallback then finishSplash() end
end

connections[#connections + 1] = RunService.Heartbeat:Connect(function()
    if stopping then return end
    if _G.AD_STOP then session.Stop("Đã dừng"); return end
    local now = os.clock()
    if not ready then
        if now < nextTick then return end
        nextTick = now + CFG.TickInterval
        updateStartup(now)
        return
    end
    if now < nextTick then return end
    nextTick = now + CFG.TickInterval
    if not gameLoaded() then status("Chờ game tải...", COLOR.idle); return end
    for remote, call in pairs(pending) do
        if now >= call.deadline then
            cancelThread(call.thread)
            pending[remote] = nil
            status("Remote timeout; sẽ thử lại", COLOR.error)
        end
    end
    if traveling or startingJob or worker then return end
    if not validCharacter() then status("Chờ nhân vật...", COLOR.idle); return end
    local ok, active, state = readState()
    if not ok then
        status(stateRequest and "Đang đọc state..." or "Không đọc được state", stateRequest and COLOR.idle or COLOR.error)
        return
    end
    if not active then
        resetProgress()
        setBar(0)
        if now < nextJob then return end
        local position, prompt = findPad()
        if not position then status("Chưa tìm thấy DeliveryJobPad", COLOR.error); return end
        nextJob = now + CFG.JobRetryDelay
        runWorker("start", function()
            local result = startJob(position, prompt)
            nextJob = os.clock() + CFG.JobRetryDelay
            return result
        end)
        return
    end
    if type(state) ~= "table" then status("Chờ dữ liệu job...", COLOR.idle); return end
    local items, capacity = state.ItemsCarried, state.MaxCapacity
    local pickup, destination = state.PickupPosition, state.DestinationPosition
    if type(items) ~= "number" or type(capacity) ~= "number"
        or items ~= items or capacity ~= capacity or capacity <= 0 or items < 0
        or items == math.huge or capacity == math.huge then
        status("State thiếu dữ liệu hợp lệ", COLOR.error)
        return
    end
    local pickupChanged = typeof(lastPickup) == "Vector3" and typeof(pickup) == "Vector3"
        and not samePosition(lastPickup, pickup)
    local destinationChanged = typeof(lastDestination) == "Vector3" and typeof(destination) == "Vector3"
        and not samePosition(lastDestination, destination)
    if lastCapacity ~= capacity or pickupChanged then resetProgress() end
    if lastItems ~= items or destinationChanged then pickStuck, destStuck = nil, nil end
    if type(lastItems) == "number" and items > lastItems then
        pickAttempts, pickDropOffset, pickBaseItems = 0, CFG.PickupDropStart, nil
    end
    if destinationChanged or (type(lastItems) == "number" and items < lastItems) then
        destAttempts, destDropOffset = 0, CFG.PickupDropStart
        if destinationChanged then routeProgress = nil end
    end
    lastItems, lastCapacity = items, capacity
    if validVector(pickup) then
        if not validVector(lastPickup) or not samePosition(lastPickup, pickup) then pickupSince = now end
        lastPickup = pickup
    end
    if validVector(destination) then
        if not validVector(lastDestination) or not samePosition(lastDestination, destination) then destinationSince = now end
        lastDestination = destination
    end
    if items >= capacity then phase = "delivery"
    elseif phase == "delivery" and items == 0 then phase = "pickup"; routeProgress = nil
    elseif phase == nil then phase = "pickup" end
    session.Progress = {
        phase = phase, items = items, capacity = capacity,
        pickup = lastPickup, destination = lastDestination,
    }
    local delivering = phase == "delivery"
    local target
    if delivering then target = destination else target = pickup end
    local color = delivering and COLOR.delivery or COLOR.pickup
    local mode = capacity == 8 and "Hard" or capacity == 4 and "Normal" or "Custom"
    detail(string.format("items %d/%d | %s", items, capacity, mode))
    local barFraction = items / capacity
    if delivering and routeProgress then barFraction = routeProgress end
    setBar(barFraction)
    if not validVector(target) then
        pickStuck, destStuck = nil, nil
        status(delivering and "Chờ dest..." or "Chờ pickup...", COLOR.idle)
        return
    end
    if now - (pickupSince or 0) < 0.20 then
        status("Chờ dữ liệu điểm nhận...", COLOR.idle)
        return
    end
    if delivering and now - (destinationSince or 0) < 0.20 then
        status("Chờ dữ liệu điểm giao...", COLOR.idle)
        return
    end
    local distance = xzDistance(root.Position, target)
    local vertical = math.abs(root.Position.Y - (target.Y + CFG.StandOffset))
    local landed = false
    if humanoid then
        local floorOK, floor = pcall(function() return humanoid.FloorMaterial end)
        if floorOK and floor ~= nil and Enum.Material ~= nil then
            landed = floor ~= Enum.Material.Air
        end
    end
    if not landed then
        landed = vertical <= CFG.InteractVertical
            and math.abs(root.AssemblyLinearVelocity.Y) < 8
    end
    if distance > CFG.InteractDistance then
        pickStuck, destStuck = nil, nil
        status((delivering and "→ giao " or "→ nhặt ") .. tostring(math.floor(distance)), color)
        runWorker("travel", function()
            return flyTo(target, delivering and "→ giao " or "→ nhặt ", delivering)
        end)
        return
    end
    if delivering then
        destStuck = destStuck or now
        pickStuck = nil
        if now - destStuck >= CFG.StuckTimeout then
            runWorker("travel", function() return teleportStuckReset(target, true) end)
            return
        end
    else
        if not landed then
            pickBaseItems, pickStuck = items, nil
            status("Đang hạ cánh...", color)
            return
        end
        if pickBaseItems == nil then pickBaseItems = items end
        if items > pickBaseItems then
            pickAttempts, pickDropOffset = 0, CFG.PickupDropStart
            pickBaseItems, pickStuck = items, now
        elseif pickStuck == nil then
            pickBaseItems, pickStuck = items, now
        end
        if items <= pickBaseItems and now - pickStuck >= CFG.StuckTimeout then
            runWorker("travel", function() return teleportStuckReset(target, false) end)
            return
        end
    end
    if now >= nextAfkJump and vertical <= CFG.InteractVertical then
        nextAfkJump = now + CFG.AfkJumpInterval
        jumpOnce()
    end
    if vertical > CFG.InteractVertical then
        status("Chờ hạ cánh / kiểm tra Y", COLOR.stuck)
        return
    end
    refreshRemotes()
    local remote = delivering and completeRemote or pickupRemote
    if not validRemote(remote) then
        status("Remote nhặt/trả đã mất; chờ tải lại", COLOR.error)
        return
    end
    if delivering then
        status("Đang giao", color)
    else
        local left = math.max(0, CFG.StuckTimeout - (now - (pickStuck or now)))
        if left > 0 then
            status(string.format("Chờ nhặt %.1fs", left), color)
        else
            status("Đang nhặt", color)
        end
    end
    sendRemote(remote)
end)

canResume = true
status("Auto Delivery đã sẵn sàng", COLOR.idle)
