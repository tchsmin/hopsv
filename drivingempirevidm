local function pointClear(position)
    if typeof(position) ~= "Vector3" then return false end
    local ok, hits = pcall(function()
        if not overlapParams then
            local created, params = pcall(function() return OverlapParams.new() end)
            if not created or not params then return nil end
            overlapParams = params
            overlapParams.FilterType = Enum.RaycastFilterType.Exclude
            pcall(function() overlapParams.MaxParts = 30 end)
        end
        overlapParams.FilterDescendantsInstances = character and {character} or {}
        return workspace:GetPartBoundsInBox(CFrame.new(position), Vector3.new(1.2, 4, 1.2), overlapParams)
    end)
    if ok and type(hits) == "table" then
        for _, part in ipairs(hits) do
            local collideOK, collide = pcall(function() return part.CanCollide end)
            if collideOK and collide == true then return false end
        end
        return true
    end
    local above = raycast(position + Vector3.new(0, 7, 0), Vector3.new(0, -10, 0))
    if above and above.Position.Y > position.Y + 3.2 then return false end
    local chest = position + Vector3.new(0, 1.4, 0)
    for _, direction in ipairs({
        Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
        Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
    }) do
        if raycast(chest, direction * 1.5) then return false end
