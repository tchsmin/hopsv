local function animateUI(dt)
    if not gui.Parent then return end
    dt = math.min(tonumber(dt) or 0.016, 0.1)
    if dt < 0 then dt = 0 end
    uiTime = uiTime + dt
    for _, blob in ipairs(blobs) do
        local blobFrame = blob.frame
        if blobFrame and blobFrame.Parent then
            local px = blob.x + math.sin(uiTime * blob.speed + blob.phase) * blob.range
            local py = blob.y + math.cos(uiTime * blob.speed * 0.85 + blob.phase) * blob.range * 0.7
            blobFrame.Position = UDim2.fromOffset(px, py)
        end
    end
    cardStrokeGradient.Rotation = (uiTime * 40) % 360
    splashStrokeGradient.Rotation = 360 - (uiTime * 55) % 360
    floatStrokeGradient.Rotation = (uiTime * 50) % 360
    titleGradient.Rotation = 12 + math.sin(uiTime * 0.7) * 18
    splashTitleGradient.Rotation = 12 + math.sin(uiTime * 0.5) * 24
    splashOpen = splashOpen + ((splashWanted and 1 or 0) - splashOpen) * math.min(1, dt * 9)
    local open = math.clamp(splashOpen, 0, 1)
    if splashGroupFade then splashGroup.GroupTransparency = 1 - open end
    splashGroup.Position = UDim2.new(0.5, 0, 0.5, (1 - open) * 26)
    splashGroup.Visible = open > 0.01
    splashValue = splashValue + (splashTarget - splashValue) * math.min(1, dt * 7)
    local value = math.clamp(splashValue, 0, 1)
    splashFill.Size = UDim2.new(value, 0, 0, 6)
    splashPercent.Text = string.format("%d%%", math.floor(value * 100 + 0.5))
end

